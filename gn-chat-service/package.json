{
  "name": "gn-chat-service",
  "version": "1.0.0",
  "description": "Chat microservice for GN Farm",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'Chat service build completed - no build step required for Node.js'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "lint": "eslint src/ tests/ || echo 'ESLint not configured'",
    "lint:fix": "eslint src/ tests/ --fix || echo 'ESLint not configured'",
    "format": "prettier --write src/ tests/ || echo 'Prettier not configured'"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.2.0",
    "joi": "^17.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "sharp": "^0.32.6",
    "socket.io": "^4.7.2",
    "socket.io-stream": "^0.9.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  }
}
