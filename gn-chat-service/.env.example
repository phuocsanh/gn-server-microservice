#####################################################################
# ENVIRONMENT VARIABLES CHO GN CHAT SERVICE (NODE.JS)
# Tệp này chứa các biến môi trường cần thiết cho dịch vụ chat
# Sao chép thành .env và điền các giá trị thực tế
# Lưu ý: Không commit file .env vào git (chứa thông tin nhạy cảm)
#####################################################################

# ===== CẤU HÌNH NODE.JS SERVER =====
# Thiết lập cơ bản cho Express.js server
PORT=3000                              # Cổng chạy chat service
NODE_ENV=development                   # Môi trường: development, production, test

# ===== CẤU HÌNH MONGODB =====
# MongoDB lưu trữ tin nhắn chat, cuộc trò chuyện
MONGODB_URI=mongodb://mongo_gn_farm:27017/gn_chat  # URI kết nối MongoDB

# ===== CẤU HÌNH POSTGRESQL =====
# PostgreSQL chia sẻ thông tin người dùng với Go server
POSTGRES_HOST=postgres_gn_farm         # Host PostgreSQL
POSTGRES_PORT=5432                     # Cổng PostgreSQL
POSTGRES_USER=postgres                 # User PostgreSQL
POSTGRES_PASSWORD=123456               # Password PostgreSQL
POSTGRES_DB=GO_GN_FARM                # Database PostgreSQL

# ===== CẤU HÌNH REDIS =====
# Redis cho real-time features, online status, socket connections
REDIS_HOST=redis_gn_farm               # Host Redis
REDIS_PORT=6379                        # Cổng Redis
REDIS_PASSWORD=                        # Password Redis (bỏ trống nếu không có)

# JWT Configuration
JWT_SECRET=xxx.yyy.zzz
JWT_EXPIRATION=1h

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Testing Configuration
TEST_MONGODB_URI=mongodb://localhost:27017/gn_chat_test
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=123456
TEST_POSTGRES_DB=GO_GN_FARM_TEST
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379

# Image Compression Configuration
ENABLE_IMAGE_COMPRESSION=true
IMAGE_MAX_DIMENSION=1920
JPEG_QUALITY=80
PNG_QUALITY=80
WEBP_QUALITY=80

# Video Compression Configuration
ENABLE_VIDEO_COMPRESSION=true
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_BITRATE=1500k
VIDEO_PRESET=medium
VIDEO_CRF=23
VIDEO_MAX_SIZE_MB=50
