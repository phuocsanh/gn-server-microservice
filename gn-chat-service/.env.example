# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://mongo_gn_farm:27017/gn_chat

# PostgreSQL Configuration
POSTGRES_HOST=postgres_gn_farm
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=GO_GN_FARM

# Redis Configuration
REDIS_HOST=redis_gn_farm
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=xxx.yyy.zzz
JWT_EXPIRATION=1h

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Image Compression Configuration
ENABLE_IMAGE_COMPRESSION=true
IMAGE_MAX_DIMENSION=1920
JPEG_QUALITY=80
PNG_QUALITY=80
WEBP_QUALITY=80

# Video Compression Configuration
ENABLE_VIDEO_COMPRESSION=true
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_BITRATE=1500k
VIDEO_PRESET=medium
VIDEO_CRF=23
VIDEO_MAX_SIZE_MB=50
