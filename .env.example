#####################################################################
# ENVIRONMENT CONFIGURATION CHO GN FARM MICROSERVICES
# File mẫu cấu hình biến môi trường cho toàn bộ hệ thống
#
# CÁCH SỬ DỤNG:
# 1. Sao chép file này thành .env: cp .env.example .env
# 2. Điền các giá trị thực tế cho môi trường của bạn
# 3. KHÔNG BAO GIờ commit file .env vào Git!
#
# QUẢN LÝ MÔI TRƯỜNG:
# - Development: Sử dụng localhost và test credentials
# - Staging: Sử dụng staging database và services
# - Production: Sử dụng production credentials (BẢO MẬT CAO)
#
# BẢO MẬT:
# - Đổi tất cả passwords/secrets trong production
# - Sử dụng strong passwords và random keys
# - Không share credentials qua email/chat
#
# Tác giả: GN Farm Development Team
# Phiên bản: 1.0
#####################################################################

# =================================
# GN Farm Microservices Environment Configuration
# =================================

# =================================
# Database Configuration
# =================================

# PostgreSQL (Primary Database) - CHANGE PASSWORDS IN PRODUCTION!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GnFarm2024SecurePass!
POSTGRES_DB=GO_GN_FARM
POSTGRES_DB_TEST=GO_GN_FARM_TEST
POSTGRES_SSL_MODE=require
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_MAX_IDLE_CONNECTIONS=5
POSTGRES_CONNECTION_LIFETIME=300s

# MongoDB (Chat Service)
MONGODB_URI=mongodb://localhost:27017/gn_chat
MONGODB_URI_TEST=mongodb://localhost:27017/gn_chat_test
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Redis (Caching & Sessions) - SECURE IN PRODUCTION!
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=GnFarmRedis2024SecurePass!
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_TLS_ENABLED=false

# =================================
# Application Configuration
# =================================

# Go Server
GO_ENV=development
GO_SERVER_PORT=8002
GO_SERVER_HOST=0.0.0.0
GO_SERVER_READ_TIMEOUT=30s
GO_SERVER_WRITE_TIMEOUT=30s
GO_SERVER_IDLE_TIMEOUT=60s

# Chat Service (Node.js)
NODE_ENV=development
CHAT_SERVICE_PORT=3000
CHAT_SERVICE_HOST=0.0.0.0

# =================================
# Security Configuration
# =================================

# JWT Configuration (CRITICAL: Change these in production!)
JWT_SECRET=gn_farm_jwt_secret_2024_change_this_in_production_with_strong_random_key
JWT_ACCESS_TOKEN_EXPIRE=15m
JWT_REFRESH_TOKEN_EXPIRE=7d
JWT_ISSUER=gn-farm-api
JWT_AUDIENCE=gn-farm-users

# API Keys & Secrets
API_SECRET_KEY=your-api-secret-key
ENCRYPTION_KEY=your-32-character-encryption-key

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# =================================
# External Services
# =================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=gn-chat-files
AWS_S3_BUCKET_REGION=ap-southeast-1
AWS_S3_PRESIGNED_URL_EXPIRE=3600

# SendGrid Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=noreply@gnfarm.com
SENDER_NAME=GN Farm

# =================================
# File Upload & Processing
# =================================

# File Upload Limits
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,application/pdf

# Image Processing
ENABLE_IMAGE_COMPRESSION=true
IMAGE_MAX_DIMENSION=1920
IMAGE_QUALITY_JPEG=80
IMAGE_QUALITY_PNG=80
IMAGE_QUALITY_WEBP=80

# Video Processing
ENABLE_VIDEO_COMPRESSION=true
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_BITRATE=1500k
VIDEO_PRESET=medium
VIDEO_CRF=23
VIDEO_MAX_SIZE_MB=50

# =================================
# Logging Configuration
# =================================

# Log Levels: debug, info, warn, error
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30

# =================================
# Monitoring & Health Checks
# =================================

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# Metrics Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# =================================
# Rate Limiting
# =================================

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Chat Rate Limiting
CHAT_RATE_LIMIT_MESSAGES_PER_MINUTE=60
CHAT_RATE_LIMIT_FILES_PER_HOUR=20

# =================================
# Kafka Configuration (Optional)
# =================================

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gn-farm-service
KAFKA_GROUP_ID=gn-farm-group
KAFKA_AUTO_OFFSET_RESET=earliest

# =================================
# Development & Testing
# =================================

# Development Mode
DEBUG_MODE=true
ENABLE_SWAGGER=true
ENABLE_PROFILING=false

# Testing Configuration
TEST_DATABASE_URL=postgres://postgres:123456@localhost:5432/GO_GN_FARM_TEST
TEST_MONGODB_URL=mongodb://localhost:27017/gn_chat_test
TEST_REDIS_URL=redis://localhost:6379/1

# Mock Services (for testing)
MOCK_EMAIL_SERVICE=false
MOCK_S3_SERVICE=false
MOCK_EXTERNAL_APIS=false

# =================================
# Performance Configuration
# =================================

# Connection Pooling
DB_POOL_MAX_OPEN_CONNECTIONS=25
DB_POOL_MAX_IDLE_CONNECTIONS=5
DB_POOL_CONNECTION_MAX_LIFETIME=300s

# Caching
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER_SESSION=1800
CACHE_TTL_API_RESPONSE=300

# Request Timeouts
HTTP_CLIENT_TIMEOUT=30s
DATABASE_QUERY_TIMEOUT=30s
EXTERNAL_API_TIMEOUT=10s

# =================================
# Feature Flags
# =================================

# Chat Features
ENABLE_FILE_SHARING=true
ENABLE_VIDEO_CALLS=false
ENABLE_SCREEN_SHARING=false
ENABLE_MESSAGE_ENCRYPTION=false

# User Features
ENABLE_USER_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false

# Product Features
ENABLE_PRODUCT_REVIEWS=true
ENABLE_PRODUCT_RECOMMENDATIONS=false
ENABLE_INVENTORY_TRACKING=true

# =================================
# Backup & Recovery
# =================================

# Database Backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=gn-farm-backups

# =================================
# Notification Configuration
# =================================

# Push Notifications
ENABLE_PUSH_NOTIFICATIONS=false
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id

# Email Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
EMAIL_QUEUE_ENABLED=true
EMAIL_RETRY_ATTEMPTS=3

# =================================
# Security Headers & Policies
# =================================

# Security Headers
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# Session Configuration
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=86400
