# GN Farm Microservices - Combined .gitignore

# OS specific files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
logs/
storages/logs/

# Environment variables
#.env

# Go specific (gn-farm-go-server)
docs/
cmd/cli/
config/production.yaml
tmp/

# Node.js specific (gn-chat-service)
node_modules/
dist/
build/

# Build output
bin/
